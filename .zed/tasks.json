[
  {
    "label": "DevKit tests",
    "command": "cargo",
    "env": {
      "RUSTFLAGS": "-C instrument-coverage -Z coverage-options=condition",
    },
    "args": [
      "+nightly",
      "llvm-cov",
      "--html",
      "--package",
      "creamy-compiler",
      "--package",
      "compiler-utils",
    ],
  },
  {
    "label": "Install Creamy Devkit CLI",
    "command": "cargo",
    "args": [
      "+stable",
      "install",
      "creamy-devkit-cli",
      "--path",
      "devkit/creamy-devkit-cli",
    ],
  },
]
