[
  {
    "label": "[Workspace] Code coverage",
    "command": "cargo",
    "args": ["+nightly", "llvm-cov", "--all-features", "--doctests", "--html", "--open"],
  },
  {
    "label": "Install Creamy Devkit CLI",
    "command": "cargo",
    "args": [
      "+stable",
      "install",
      "creamy-devkit-cli",
      "--path",
      "tools/creamy-devkit-cli",
    ],
  },
]
