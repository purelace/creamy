{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "imports": {
          "prefix": "self",
        },
        "check": {
          "command": "clippy",
          "extraArgs": ["--", "-W", "clippy::pedantic"],
        },
        "rustfmt": {
          "extraArgs": ["+nightly"],
        },
      },
    },
  },
}
