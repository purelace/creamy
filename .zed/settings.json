{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "imports": {
          "prefix": "self",
        },
        "check": {
          "command": "clippy",
          "extraArgs": ["--", "-W", "clippy::pedantic"],
        },
        "rustfmt": {
          "extraArgs": ["+nightly"],
        },
        "cargo": {
          "extraArgs": ["--target-dir", "target/analyzer"],
          "buildScripts": {
            "enable": true,
          },
        },
        "procMacro": {
          "enable": true,
        },
        "diagnostics": {
          "enable": true,
        },
      },
    },
  },
}
