flags WindowState {
    Fullscreen,
    Windowed,
    Maximized,
    Focused,
}

bitset Position {
    x: u32:4,
    y: u32:8
}

struct Location {
    x: i32,
    y: i32
}


struct Object {
    size: Size,
    location: Location,
    bit: Position,
}

object Window {
    id: u64,
    size: Size,
    location: Location,
    state: WindowState,
    additional: Array<u8>,
}

struct Size {
    w: i32,
    h: i32,
    option: WindowState,
}

[Builtin]
object String {
    inner: Array<u8>,
}

enum[u8] LogKind {
    Debug,
    Info,
    Warning,
    Error,
}

[Timeout(1)]
stream[I] Log {
    kind: LogKind,
    content: String,
}
