#name    "system"
#version "1.0.0"
#access  "Public"
#schema  1

// Reference: cbus-core
//[Builtin]
//struct SubscriberId {
//    value: u8,
//}

// Reference: cbus-core
//[Builtin]
//struct ProtocolId {
//    value: u8,
//}

// Reference: Rust strings
//[Builtin]
//object String {
//    inner: Array<u8>,
//}

message[O] ProtocolDeclared {
    version: u32,
    provider: u8,
    protocol_id: u8,
}

message[O] ProtocolUndeclared {
    provider: u8,
    protocol_id: u8,
}

message[O] ConsumerAppeared {
    protocol_id: u8,
    consumer_id: u8,
}

message[O] ConsumerDisappeared {
    protocol_id: u8,
    consumer_id: u8,
}

message[D] StreamKeepAlive {
    stream_kind: u8,
    stream_id: u8,
}

message[D] StreamCancel {
    stream_kind: u8,
    stream_id: u8,
}

enum[u8] LogType {
    Debug   = 0,
    Info    = 1,
    Warning = 2,
    Error   = 3,
}

stream[I] Log {
    kind: LogType,
    content: Array<u8>,
}

