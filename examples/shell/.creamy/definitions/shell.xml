<?xml version="1.0" encoding="UTF-8" ?>
<!-- TODO: см. пункт 10 в файле fix-->
<protocol name="shell" version="1.0.0">

    <group name="setup" access="Public">

        <stream kind="8" name="RegisterCommand" timeout="4" direction="Outgoing">
            <head>
                <field name="length" type="u32"/>
                <field name="data" type="[u8; 20]"/>
            </head>
            <payload>
                <field name="data" type="[u8; 27]"/>
            </payload>
            <tail>
                <field name="data" type="[u8; 27]"/>
            </tail>
        </stream>

        <stream kind="9" name="SetCommandName" timeout="4" direction="Incoming">
            <head>
                <field name="length" type="u32"/>
                <field name="data" type="[u8; 20]"/>
            </head>
            <payload>
                <field name="data" type="[u8; 27]"/>
            </payload>
            <tail>
                <field name="data" type="[u8; 27]"/>
            </tail>
        </stream>

        <stream kind="10" name="AddCommandArgument" timeout="4" direction="Incoming">
            <head>
                <field name="length" type="u32"/>
                <field name="data" type="[u8; 20]"/>
            </head>
            <payload>
                <field name="data" type="[u8; 27]"/>
            </payload>
            <tail>
                <field name="data" type="[u8; 27]"/>
            </tail>
        </stream>

        <message kind="11" name="ExecuteCommand" direction="Incoming">
            <field name="ignore" type="[u8; 27]"/>
        </message>

    </group>

</protocol>
