<?xml version="1.0" encoding="UTF-8" ?>
<protocol name="system" version="1.0.0">

    <!-- TODO: добавить рефененсы на типы других протоколов -->
    <!-- TODO: bit vector type -->
    <!-- Builtin group -->
    <group name="builtin" access="Public">
        <message kind="0" name="PluginAppeared" direction="Incoming">
            <field name="plugin_id" type="u8" />
        </message>

        <message kind="1" name="PluginDisappeared" direction="Incoming">
            <field name="plugin_id" type="u8" />
        </message>

        <message kind="2" name="ProtocolDeclared" direction="Incoming">
            <field name="version" type="u32" />
            <field name="plugin_id" type="u8" />
            <field name="group_id" type="u8" />
        </message>

        <message kind="3" name="ProtocolUndeclared" direction="Incoming">
            <field name="plugin_id" type="u8" />
            <field name="group_id" type="u8" />
        </message>

        <message kind="4" name="ProtocolRedeclared" direction="Incoming">
            <field name="version" type="u32" />
            <field name="plugin_id" type="u8" />
            <field name="group_id" type="u8" />
        </message>

        <message kind="5" name="StreamKeepAlive" direction="Duplex">
            <field name="stream_kind" type="u8" />
            <field name="stream_id" type="u8" />
        </message>

        <message kind="6" name="StreamCancel" direction="Duplex">
            <field name="stream_kind" type="u8" />
            <field name="stream_id" type="u8" />
        </message>

        <enum name="LogType" repr="u8">
            <variant name="Debug" value="0" />
            <variant name="Info" value="1" />
            <variant name="Warning" value="2" />
            <variant name="Error" value="3" />
        </enum>

        <!-- TODO: protocol extension (временно стоит Duplex, но только до того как будут внедрены расширения системного протокола)-->
        <stream kind="7" name="Log" timeout="4" direction="Duplex">
            <head>
                <field name="log_type" type="LogType" />
                <field name="length" type="u32" />
                <field name="data" type="[u8; 20]" />
            </head>
            <payload>
                <field name="data" type="[u8; 27]" />
            </payload>
            <tail>
                <field name="data" type="[u8; 27]" />
            </tail>
            <!--
            <result>
                <field name="log_type" type="LogType" source="log_type"/>
                <field name="bytes" type="u8" is_dynamic="true" capacity="length" source="data"/>
            </result>

            -->
        </stream>

        <!--
        <obsolete until="2.0" reason="Test" replaced_by="ProtocolRedeclared">
            <message kind="4" name="ProtocolRedeclaredOld">
                <field name="version" type="u32" />
                <field name="provider" type="u8" />
                <field name="group_id" type="u8" />
            </message>
        </obsolete>
        -->
    </group>
</protocol>
